{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DÇK-EÖS Fiyat Endeksi",
  "version": "1.0.0",
  "identifier": "org.dck.eos.fiyatendeksi",
  "build": {
    "beforeDevCommand": "cd ../frontend && yarn start",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "cd ../frontend && yarn build",
    "frontendDist": "../frontend/build"
  },
  "app": {
    "windows": [
      {
        "title": "DÇK-EÖS Fiyat Endeksi",
        "width": 1440,
        "height": 900,
        "minWidth": 1280,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}
